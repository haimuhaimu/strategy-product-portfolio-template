{
  "name": "strategy-product-portfolio-template",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-conscious Next.js portfolio template for strategy, AI, search, and recommendation product managers.",
  "keywords": [
    "product-manager-portfolio",
    "strategy-product-manager",
    "ai-product-manager",
    "portfolio-template",
    "nextjs",
    "typescript",
    "seo",
    "产品经理作品集",
    "策略产品经理"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haimuhaimu/strategy-product-portfolio-template.git"
  },
  "scripts": {
