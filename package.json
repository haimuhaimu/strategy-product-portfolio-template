{
  "name": "product-operations-portfolio-template",
  "version": "0.7.0",
  "private": true,
  "description": "A privacy-conscious Next.js personal cognition portfolio template for product managers and operations professionals.",
  "keywords": [
    "product-manager-portfolio",
    "operations-portfolio",
    "personal-cognition",
    "personal-operating-system",
    "portfolio-template",
    "nextjs",
    "typescript",
    "seo",
    "产品经理作品集",
    "运营作品集",
    "个人认知作品集"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haimuhaimu/strategy-product-portfolio-template.git"
  },
  "scripts": {
    "dev": "node scripts/next-with-wasm.mjs dev --webpack",
    "build": "node scripts/next-with-wasm.mjs build --webpack",
    "check:seo": "node scripts/check-seo.mjs",
    "init": "node scripts/init-portfolio.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:init": "node --test tests/init-portfolio.test.mjs",
    "test:showcase": "node --test tests/showcase.test.mjs",
    "test:portable-scripts": "node --test tests/next-with-wasm.test.mjs",
    "test:pages": "node --test tests/github-pages.test.mjs",
    "test:portfolio-v2": "node --test tests/portfolio-v2.test.mjs",
    "test:public": "node --test tests/public-template.test.mjs",
    "test:calibration": "node --test tests/cognitive-calibration.test.mjs",
    "test:personal-model": "node --test tests/personal-model.test.mjs",
    "test:skill": "python skills/portfolio-story-builder/scripts/audit_portfolio.py skills/portfolio-story-builder/assets/portfolio-v2-minimal.json",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.18",
    "typescript": "^5"
  }
}
